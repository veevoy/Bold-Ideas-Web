{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run validate:assets && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "validate:content": "node scripts/validate-case-studies.mjs",
    "test:content": "node --test tests/case-studies.test.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test": "npm run test:content && npm run test:sites && node --test tests/site-routes.test.mjs && node --test tests/navigation-preview.test.mjs && node --test tests/scroll-video.test.mjs",
    "media:responsive": "node scripts/generate-responsive-images.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
